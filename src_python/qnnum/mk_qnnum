OBJD = obj_86
BIND = bin_86
SRCD = .:../crsys

#CC = icx
CC =g++

vpath %.cpp $(SRCD)

SRCS = qnnum.cpp
COBJS = $(SRCS:.cpp=.o)
OBJS = $(addprefix $(OBJD)/,$(COBJS))

PROG = $(BIND)/qnnum
all : $(PROG)

.SUFFIXES: .o .cpp

#-fmodules-ts

CCFLAGS = -g  -I../crsys -std=c++17

$(PROG):  $(OBJS)
	$(CC) $(CCFLAGS) $(LNOPT) $(LIB) $^ -o $@ 

$(OBJD)/%.o : %.cpp
	$(CC) $(CCFLAGS) -c $< -o $@

clean :
	rm bin_86/qnnum obj_86/*.o
